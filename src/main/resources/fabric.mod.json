{
	"schemaVersion": 1,
	"id": "actions",
	"version": "2.0.0",
	"name": "ActionsV2",
	"description": "A powerful system to define custom actions using triggers and tasks",
	"authors": [
		"HenriTom"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/actions",
		"issues": "https://github.com/HenriTom/Actions/issues",
		"sources": "https://github.com/HenriTom/Actions",
		"wiki": "https://github.com/HenriTom/Actions/wiki",
		"discord": "https://discord.gg/XdHBJKTvxJ"
	},
	"license": "LGPL-3.0-or-later",
	"icon": "assets/actionsv2/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			{
				"value": "me.henritom.actionsv2.ActionsV2",
				"adapter": "kotlin"
			}
		],
		"client": [
			{
				"value": "me.henritom.actionsv2.ActionsV2Client",
				"adapter": "kotlin"
			}
		]
	},
	"mixins": [
		"actionsv2.mixins.json",
		{
			"config": "actionsv2.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.8",
		"java": ">=21",
		"fabric-api": "*",
		"fabric-language-kotlin": "*"
	},
	"suggests": {
		"modmenu": "*"
	},
	"language": {
		"translation": [
			"en_us",
			"de_de"
		]
	},
	"custom": {
		"modmenu": {
			"links": {
				"modmenu.modrinth": "https://modrinth.com/mod/actions",
				"modmenu.issues": "https://github.com/HenriTom/Actions/issues",
				"modmenu.wiki": "https://github.com/HenriTom/Actions/wiki",
				"modmenu.discord": "https://discord.gg/w5aWc2tgFY"
			},
			"update_checker": true
		}
	}
}